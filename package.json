{
  "name": "agentgate-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/bump-doc-pins.mjs",
    "release": "pnpm build && pnpm -r publish --access public --no-git-checks"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.0",
    "globals": "^17.11.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
