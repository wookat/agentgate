---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
}

const { title, description, canonical } = Astro.props;
const gh = 'https://github.com/wookat/agentgate';

const nav = [
  { href: '/#features', label: 'Features' },
  { href: '/compare/snyk/', label: 'Compare' },
  { href: '/advisories/', label: 'Advisories' },
  { href: '/docs/introduction/', label: 'Docs' },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1120" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="AgentGate" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://agentgate.zalize.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://agentgate.zalize.com/og.png" />
    <script is:inline>
      const t = localStorage.getItem('starlight-theme');
      if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
    </script>
  </head>
  <body class="bg-ag-bg font-sans text-ag-text antialiased">
    <header class="sticky top-0 z-50 border-b border-ag-border bg-ag-bg/80 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-ag-sm bg-ag-accent/10 text-ag-accent">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v5c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-3z"></path><path d="M9.5 10.5L7.5 12l2 1.5"></path><path d="M14.5 10.5l2 1.5-2 1.5"></path></svg>
          </span>
          <span class="text-lg font-semibold tracking-tight">AgentGate</span>
        </a>
        <nav class="hidden items-center gap-6 text-sm text-ag-muted md:flex">
          {nav.map((n) => (
            <a href={n.href} class="transition-colors duration-150 hover:text-ag-text">{n.label}</a>
          ))}
          <a href={gh} aria-label="GitHub" class="flex h-9 w-9 items-center justify-center rounded-ag-md border border-ag-border transition-colors duration-150 hover:border-ag-accent hover:text-ag-text">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.1c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.05.78 2.13v3.16c0 .3.21.66.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"></path></svg>
          </a>
        </nav>
        <button id="menuBtn" aria-label="Menu" aria-expanded="false" class="flex h-11 w-11 items-center justify-center rounded-ag-md border border-ag-border text-ag-muted md:hidden">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        </button>
      </div>
      <div id="mobileNav" class="hidden border-t border-ag-border bg-ag-bg md:hidden">
        <nav class="flex flex-col px-4 py-3 text-sm">
          {nav.map((n) => (
            <a href={n.href} class="rounded-ag-md px-3 py-3 text-ag-muted hover:bg-ag-subtle hover:text-ag-text">{n.label}</a>
          ))}
          <a href={gh} class="rounded-ag-md px-3 py-3 text-ag-muted hover:bg-ag-subtle hover:text-ag-text">GitHub</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-ag-border bg-ag-subtle/50">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-10 text-sm text-ag-muted sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
        <p>© 2026 AgentGate · Apache-2.0 · Built for the MCP ecosystem.</p>
        <div class="flex flex-wrap gap-5">
          <a href={gh} class="transition-colors duration-150 hover:text-ag-text">GitHub</a>
          <a href="/docs/introduction/" class="transition-colors duration-150 hover:text-ag-text">Docs</a>
          <a href="/advisories/" class="transition-colors duration-150 hover:text-ag-text">Advisories</a>
          <a href="/report-viewer/" class="transition-colors duration-150 hover:text-ag-text">Report viewer</a>
        </div>
      </div>
    </footer>

    <script>
      const menuBtn = document.getElementById('menuBtn');
      menuBtn?.addEventListener('click', () => {
        const nav = document.getElementById('mobileNav')!;
        nav.classList.toggle('hidden');
        menuBtn.setAttribute('aria-expanded', String(!nav.classList.contains('hidden')));
      });
    </script>
  </body>
</html>
