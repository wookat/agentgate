---
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default><slot /></Default>
<meta name="theme-color" content="#0b1120" />
<link
  rel="alternate"
  type="application/rss+xml"
  title="AgentGate MCP Advisories"
  href="https://agentgate.zalize.com/feeds/advisories.xml"
/>
<meta property="og:image" content="https://agentgate.zalize.com/og.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content="https://agentgate.zalize.com/og.png" />
<script>
  // Horizontally scrollable code blocks must be keyboard-reachable (WCAG 2.1.1).
  const makeScrollableCodeFocusable = () => {
    for (const pre of document.querySelectorAll<HTMLPreElement>('.expressive-code pre')) {
      if (pre.scrollWidth > pre.clientWidth) {
        pre.setAttribute('tabindex', '0');
        pre.setAttribute('role', 'region');
        pre.setAttribute('aria-label', 'code example');
      } else {
        pre.removeAttribute('tabindex');
      }
    }
  };
  makeScrollableCodeFocusable();
  window.addEventListener('resize', makeScrollableCodeFocusable, { passive: true });
</script>
