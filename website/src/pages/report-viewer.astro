---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{
    title: 'Scan report viewer',
    description: 'Visualize agentgate scan --format json output. Everything stays in your browser.',
    tableOfContents: false,
  }}
>
  <p>
    Load the output of <code>agentgate scan --format json</code> to get a visual, filterable
    report. Files are parsed entirely in your browser — nothing is uploaded. Format:
    <a href="/docs/spec/scan-output/">scan output spec</a>.
  </p>

  <div id="rv-input" class="rv-drop">
    <p><strong>Drop a report JSON file here</strong>, or</p>
    <p>
      <label class="rv-btn">
        Choose file<input type="file" id="rv-file" accept=".json,application/json" hidden />
      </label>
      <button class="rv-btn rv-btn-ghost" id="rv-sample" type="button">Load sample report</button>
    </p>
    <details class="rv-paste">
      <summary>…or paste JSON</summary>
      <textarea id="rv-textarea" rows="8" placeholder='{"version":1, "findings":[...], ...}'></textarea>
      <button class="rv-btn" id="rv-parse" type="button">Render</button>
    </details>
    <p class="rv-hint">
      Tip: link directly to a hosted report with <code>?url=…</code>, or use “Copy shareable
      link” after loading one (the report is encoded in the URL fragment — it never leaves the
      browser).
    </p>
    <p id="rv-error" class="rv-error" role="alert" hidden></p>
  </div>

  <div id="rv-report" hidden>
    <div class="rv-meta" id="rv-meta"></div>
    <div class="rv-summary" id="rv-summary"></div>
    <div class="rv-filters" id="rv-filters" role="group" aria-label="Filter by severity"></div>
    <div id="rv-findings"></div>
    <div id="rv-warnings"></div>
    <p>
      <button class="rv-btn" id="rv-share" type="button">Copy shareable link</button>
      <button class="rv-btn rv-btn-ghost" id="rv-reset" type="button">Load another report</button>
    </p>
  </div>

  <script>
    const SEVERITIES = ['critical', 'high', 'medium', 'low', 'info'];
    const $ = (id: string) => document.getElementById(id)!;
    let report: any = null;
    let active = new Set(SEVERITIES);

    const esc = (s: unknown) =>
      String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

    function fail(msg: string) {
      const el = $('rv-error');
      el.textContent = msg;
      el.hidden = false;
    }

    function load(text: string) {
      $('rv-error').hidden = true;
      let data: any;
      try {
        data = JSON.parse(text);
      } catch {
        return fail('Not valid JSON.');
      }
      if (!data || !Array.isArray(data.findings)) {
        return fail('Not an agentgate scan report: missing "findings" array. See the scan output spec.');
      }
      report = data;
      active = new Set(SEVERITIES);
      render();
      $('rv-input').hidden = true;
      $('rv-report').hidden = false;
    }

    /** Link MCPA advisory IDs mentioned in messages to their pages. */
    function linkAdvisories(escaped: string): string {
      return escaped.replace(/MCPA-\d{4}-\d{4}/g, (id) => `<a href="/advisories/${id.toLowerCase()}/">${id}</a>`);
    }

    function render() {
      const counts: Record<string, number> = { critical: 0, high: 0, medium: 0, low: 0, info: 0 };
      for (const f of report.findings) if (counts[f.severity] !== undefined) counts[f.severity]++;

      const servers = report.scannedServers ?? [];
      const files = report.scannedFiles ?? [];
      $('rv-meta').innerHTML = `
        <span>scanned ${esc(report.scannedAt ?? '?')}</span>
        <span>${servers.length} server(s)${servers.length ? `: ${esc(servers.slice(0, 6).join(', '))}${servers.length > 6 ? '…' : ''}` : ''}</span>
        <span>${files.length} file(s)</span>`;

      $('rv-summary').innerHTML = SEVERITIES.map(
        (s) => `<div class="rv-card rv-sev-${s}"><div class="rv-card-num">${counts[s]}</div><div>${s}</div></div>`
      ).join('') + `<div class="rv-card rv-sev-total"><div class="rv-card-num">${report.findings.length}</div><div>total</div></div>`;

      $('rv-filters').innerHTML = SEVERITIES.map(
        (s) =>
          `<button type="button" class="rv-chip rv-sev-${s} ${active.has(s) ? 'rv-on' : ''}" data-sev="${s}" aria-pressed="${active.has(s)}">${s} (${counts[s]})</button>`
      ).join('');
      $('rv-filters').querySelectorAll('button').forEach((b) =>
        b.addEventListener('click', () => {
          const s = (b as HTMLElement).dataset.sev!;
          active.has(s) ? active.delete(s) : active.add(s);
          render();
        })
      );

      const rows = report.findings
        .filter((f: any) => active.has(f.severity))
        .map((f: any) => {
          const message = linkAdvisories(esc(f.message ?? ''));
          const where = f.file ? `<code>${esc(f.file)}${f.line ? `:${f.line}` : ''}</code>` : '';
          return `<details class="rv-finding rv-sev-${esc(f.severity)}">
            <summary>
              <span class="rv-chip rv-sev-${esc(f.severity)} rv-on">${esc(f.severity)}</span>
              <span class="rv-chip">${esc(f.category ?? '')}</span>
              <span class="rv-finding-title">${esc(f.target ?? '')}</span>
            </summary>
            <div class="rv-finding-body">
              <p>${message}</p>
              <dl>
                <dt>Rule</dt><dd><a href="/docs/rules/${esc(f.category ?? '')}/"><code>${esc(f.ruleId ?? '')}</code></a></dd>
                <dt>Target</dt><dd><code>${esc(f.target ?? '')}</code></dd>
                ${where ? `<dt>Location</dt><dd>${where}</dd>` : ''}
                ${f.detail ? `<dt>Detail</dt><dd><pre>${esc(f.detail)}</pre></dd>` : ''}
              </dl>
            </div>
          </details>`;
        });
      $('rv-findings').innerHTML =
        rows.join('') || '<p class="rv-empty">No findings match the current filters.</p>';

      const warnings = report.warnings ?? [];
      $('rv-warnings').innerHTML = warnings.length
        ? `<h3>Warnings</h3><ul>${warnings.map((w: string) => `<li>${esc(w)}</li>`).join('')}</ul>`
        : '';
    }

    // --- shareable links: #r=<base64url(gzip(json))> ---
    const b64uEncode = (bytes: Uint8Array) =>
      btoa(String.fromCharCode(...bytes)).replaceAll('+', '-').replaceAll('/', '_').replace(/=+$/, '');
    const b64uDecode = (s: string) =>
      Uint8Array.from(atob(s.replaceAll('-', '+').replaceAll('_', '/')), (c) => c.charCodeAt(0));

    async function encodeShare(json: string): Promise<string> {
      const stream = new Blob([json]).stream().pipeThrough(new CompressionStream('gzip'));
      const bytes = new Uint8Array(await new Response(stream).arrayBuffer());
      return b64uEncode(bytes);
    }
    async function decodeShare(data: string): Promise<string> {
      const stream = new Blob([b64uDecode(data) as BlobPart]).stream().pipeThrough(new DecompressionStream('gzip'));
      return await new Response(stream).text();
    }

    $('rv-share').addEventListener('click', async () => {
      if (!report) return;
      const btn = $('rv-share');
      try {
        const encoded = await encodeShare(JSON.stringify(report));
        const url = `${location.origin}${location.pathname}#r=${encoded}`;
        if (url.length > 30000) {
          btn.textContent = 'Report too large to share via URL';
        } else {
          history.replaceState(null, '', `#r=${encoded}`);
          await navigator.clipboard.writeText(url);
          btn.textContent = 'Link copied!';
        }
      } catch {
        btn.textContent = 'Could not copy link';
      }
      setTimeout(() => (btn.textContent = 'Copy shareable link'), 2500);
    });

    $('rv-file').addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) file.text().then(load);
    });
    $('rv-parse').addEventListener('click', () => load(($('rv-textarea') as HTMLTextAreaElement).value));
    $('rv-reset').addEventListener('click', () => {
      history.replaceState(null, '', location.pathname);
      $('rv-report').hidden = true;
      $('rv-input').hidden = false;
    });
    $('rv-sample').addEventListener('click', async () => {
      const res = await fetch('/sample-report.json');
      load(await res.text());
    });

    const drop = $('rv-input');
    drop.addEventListener('dragover', (e) => {
      e.preventDefault();
      drop.classList.add('rv-dragging');
    });
    drop.addEventListener('dragleave', () => drop.classList.remove('rv-dragging'));
    drop.addEventListener('drop', (e) => {
      e.preventDefault();
      drop.classList.remove('rv-dragging');
      const file = e.dataTransfer?.files?.[0];
      if (file) file.text().then(load);
    });

    // Auto-load from #r= fragment or ?url= parameter.
    (async () => {
      const hash = new URLSearchParams(location.hash.slice(1));
      const shared = hash.get('r');
      if (shared) {
        try {
          load(await decodeShare(shared));
        } catch {
          fail('Could not decode the shared report link.');
        }
        return;
      }
      const url = new URLSearchParams(location.search).get('url');
      if (url) {
        try {
          const res = await fetch(url);
          if (!res.ok) throw new Error(String(res.status));
          load(await res.text());
        } catch {
          fail(`Could not fetch the report from ${url} (the host must allow CORS).`);
        }
      }
    })();
  </script>
</StarlightPage>
