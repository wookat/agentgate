{
  "name": "mcp-agentgate",
  "version": "0.5.1",
  "description": "Scan, lock, and gate your MCP servers — npm audit + lockfile + CI drift gate for the MCP era",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wookat/agentgate.git",
    "directory": "packages/cli"
  },
  "homepage": "https://agentgate.zalize.com",
  "bugs": "https://github.com/wookat/agentgate/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "supply-chain",
    "lockfile",
    "scanner",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "agentgate": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "mcp-agentgate-config-convert": "workspace:*",
    "mcp-agentgate-core": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
