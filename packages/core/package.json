{
  "name": "mcp-agentgate-core",
  "version": "0.67.13",
  "description": "AgentGate core engine: MCP scanning rule engine, lockfile spec, client config discovery",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wookat/agentgate.git",
    "directory": "packages/core"
  },
  "homepage": "https://agentgate.zalize.com",
  "bugs": "https://github.com/wookat/agentgate/issues",
  "keywords": [
    "mcp",
